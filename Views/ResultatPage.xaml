<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CalculateurAge.ViewModels"
             x:Class="CalculateurAge.Views.ResultatPage"
             x:DataType="vm:ResultatViewModel"
             Title="Resultat">

    <VerticalStackLayout Padding="20" Spacing="16">
        <Label Text="{Binding Message}" FontSize="22"/>
        <Label Text="{Binding Statut}" FontSize="18"
               FontAttributes="Bold"/>
        <Label Text="{Binding ProchainAnniversaire}" FontSize="16"/>
        <Button Text="Retour" Command="{Binding RetourCommand}"/>
    </VerticalStackLayout>

</ContentPage>
